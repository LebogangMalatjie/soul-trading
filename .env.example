# Soul Trading - example environment file.
# Copy to .env (which is git-ignored) and fill in real values. NEVER commit .env.

# --- Required ---
DATABASE_URL=postgresql://user:pass@host:6543/db   # Supabase session-pooler URL
SOUL_ACCESS_KEY=your-access-key-at-least-24-chars
SOUL_SHUTDOWN_KEY=your-shutdown-key-at-least-24-chars

# --- Local MT5 (BROKER=mt5) ---
BROKER=mt5
MT5_LOGIN=12345678
MT5_SERVER=YourBroker-MT5Trial
MT5_PASSWORD=your-mt5-password
SYMBOL_MAP={"US30":"US30m","XAUUSD":"XAUUSDm","XAGUSD":"XAGUSDm","BTCUSD":"BTCUSDm","US500":"US500m"}

# --- News Bias Engine ---
NEWS_BIAS_ENABLED=1
NEWS_BIAS_DRY_RUN=0
NEWS_BIAS_TARGET_ZAR=15000

# --- Telegram notifications (get token from @BotFather; REVOKE if ever leaked) ---
# TELEGRAM_BOT_TOKEN=123456:ABC-your-real-bot-token
# TELEGRAM_CHAT_ID=your-chat-id            # DM or group the bot posts to
# TELEGRAM_SIGNAL_CHAT_ID=@your_channel    # optional: channel for trade signals

# --- AI meta layer (optional) ---
AI_META_LAYER_PATH=C:\Users\lebog\OneDrive\Desktop\ai_meta_layer.py

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
